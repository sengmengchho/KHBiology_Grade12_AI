# OS files
.DS_Store
Thumbs.db

# Large data files (directory structure is kept with .gitkeep files)
data/raw/*.pdf
data/processed/*.json
data/processed/archive_v3/
# data/extracted/biology_raw_text.jsonl is tracked as corpus provenance.

# Archived runs and logs are kept on disk but not versioned.
# The two negation entries are replay fixtures used by
# tests/test_citation_integrity.py.
data/evaluation/archive/*
!data/evaluation/archive/answer_evaluations_v3.json
!data/evaluation/archive/answer_evaluations_v3_q84.json
archive/root/

# Local logs and scratch output
*.log
*.err
